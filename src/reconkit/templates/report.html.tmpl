<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<style>
  :root { --critical:#d73a49; --high:#e36209; --medium:#d4a72c; --low:#1a7f37; --info:#57606a; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
         color: #1f2328; margin: 0; background: #f6f8fa; line-height: 1.55; }
  .container { max-width: 980px; margin: 0 auto; padding: 32px 24px 72px; }
  h1 { font-size: 28px; border-bottom: 3px solid #0969da; padding-bottom: 12px; margin-top: 0; }
  h2 { font-size: 21px; margin-top: 44px; border-bottom: 1px solid #d0d7de; padding-bottom: 6px; }
  h3 { font-size: 16px; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0; background: #fff; }
  th, td { border: 1px solid #d0d7de; padding: 6px 10px; text-align: left; vertical-align: top; font-size: 13px; }
  th { background: #f6f8fa; font-weight: 600; }
  code { background: #eff1f3; padding: 1px 5px; border-radius: 4px;
         font-family: SFMono-Regular, Consolas, "Liberation Mono", monospace; font-size: 12px; }
  .meta td:first-child { font-weight: 600; background: #f6f8fa; white-space: nowrap; }
  .sev { display: inline-block; font-weight: 700; text-transform: uppercase; font-size: 11px;
         letter-spacing: .5px; padding: 2px 9px; border-radius: 12px; color: #fff; }
  .sev-critical { background: var(--critical); } .sev-high { background: var(--high); }
  .sev-medium { background: var(--medium); } .sev-low { background: var(--low); } .sev-info { background: var(--info); }
  .finding { background: #fff; border: 1px solid #d0d7de; border-left: 4px solid var(--info);
             border-radius: 6px; padding: 16px 18px; margin: 14px 0; }
  .finding.critical { border-left-color: var(--critical); }
  .finding.high { border-left-color: var(--high); }
  .finding.medium { border-left-color: var(--medium); }
  .finding.low { border-left-color: var(--low); }
  .finding h3 { margin-top: 0; margin-bottom: 10px; }
  .kv { font-size: 13px; margin: 6px 0; }
  .kv b { color: #24292f; }
  .evidence { background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 4px; padding: 8px 10px;
              font-family: monospace; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
  .muted { color: #57606a; font-size: 13px; }
  .callout { background: #fff8c5; border: 1px solid #d4a72c; border-radius: 6px; padding: 12px 16px; font-size: 13px; }
  @media print { body { background: #fff; } .container { max-width: none; padding: 0; }
                 .finding { break-inside: avoid; } }
</style>
</head>
<body>
<div class="container">
$body
</div>
</body>
</html>
